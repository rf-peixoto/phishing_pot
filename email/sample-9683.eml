  <style>
    html,body{margin:0!important;padding:0!important;width:100%!important;height:100%!important}
    *{-ms-text-size-adjust:100%;-webkit-text-size-adjust:100%}
    table,td{border-collapse:collapse!important}
    img{border:0;outline:none;text-decoration:none;-ms-interpolation-mode:bicubic;display:block}
    a{text-decoration:none}

    .container{width:100%;max-width:600px}
    .px{padding-left:24px;padding-right:24px}
    .py{padding-top:24px;padding-bottom:24px}
    
    /* نصوص أكثر جرأة وحيوية */
    .h1{font:900 32px/1.2 'Inter',system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;color:#0F172A;margin:0;letter-spacing:-0.5px}
    .lead{font:500 17px/1.6 'Inter',system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;color:#334155;margin:0}
    
    /* شارات (Pills) حماسية بتدرج لوني */
    .pill{display:inline-block;padding:6px 14px;border-radius:999px;font:800 11px/1 'Inter',system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;color:#ffffff;background:linear-gradient(135deg, #FF007A 0%, #7928CA 100%);text-transform:uppercase;letter-spacing:0.5px}
    .muted{color:#64748B;font:500 13px/1.4 'Inter',system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif}
    .sp16{height:16px;line-height:16px;font-size:16px}
    .sp24{height:24px;line-height:24px;font-size:24px}
    .sp32{height:32px;line-height:32px;font-size:32px}

    /* كروت بظلال ناعمة وتأثيرات تفاعلية */
    .card{background:#ffffff;border:1px solid #E2E8F0;border-radius:24px;box-shadow:0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.05)}
    .prize{background:#F8FAFC;border:1px solid #E2E8F0;border-radius:16px;transition:all 0.3s ease}
