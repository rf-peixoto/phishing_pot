      .lead{color:#CBD5E1!important}
      .muted{color:#94A3B8!important}
      .prize{background:#334155!important;border-color:#475569!important}
      .benefit{background:#14532D!important;border-color:#166534!important;color:#4ADE80!important}
      .link{color:#38BDF8!important}
    }
    [data-ogsc] .card{background:#1E293B!important;border-color:#334155!important}
    [data-ogsc] .h1{color:#F8FAFC!important}
    [data-ogsc] .lead{color:#CBD5E1!important}
  </style>
