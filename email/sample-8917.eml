/* Reset & base styles for all email clients */
        * {
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Inter', 'SF Pro Text', Roboto, Helvetica, Arial, sans-serif;
            line-height: 1.4;
        }
        body {
            background-color: #f0f2f5;
            margin: 0;
            padding: 24px 0;
        }
        /* Main container */
        .email-wrapper {
            max-width: 600px;
            width: 100%;
            margin: 0 auto;
            background-color: #ffffff;
            border-radius: 32px;
            overflow: hidden;
            box-shadow: 0 20px 35px -12px rgba(0, 0, 0, 0.08), 0 1px 2px rgba(0, 0, 0, 0.02);
        }
        /* Premium header with gradient accent */
        .brand-header {
            background: linear-gradient(135deg, #0A0F1C 0%, #0B1426 100%);
            padding: 32px 32px 28px 32px;
            text-align: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }
        .logo-container {
            display: inline-block;
            max-width: 220px;
            width: 85%;
            margin: 0 auto;
        }
        .logo-svg {
            width: 100%;
            height: auto;
            display: block;
            filter: brightness(0) invert(1);
        }
        /* Hero badge */
        .update-badge {
            display: inline-block;
            background: rgba(255, 255, 255, 0.12);
            backdrop-filter: blur(4px);
            border-radius: 60px;
            padding: 6px 14px;
            font-size: 12px;
            font-weight: 500;
            letter-spacing: 0.3px;
            color: #E9F0FF;
            margin-bottom: 20px;
            border: 0.5px solid rgba(255,255,255,0.2);
        }
        /* Content area */
        .content-area {
            padding: 40px 36px 44px 36px;
            background: #FFFFFF;
        }
        /* Typography refined */
        h1 {
            font-size: 32px;
            font-weight: 700;
            color: #0A0F1C;
            margin-bottom: 18px;
            line-height: 1.25;
            letter-spacing: -0.3px;
        }
        .highlight-text {
            background: linear-gradient(120deg, #F5F9FF 0%, #EFF3FC 100%);
            padding: 2px 8px;
            border-radius: 12px;
            font-weight: 600;
        }
        p {
            font-size: 16px;
            color: #2C3A4B;
            line-height: 1.55;
            margin-bottom: 20px;
            font-weight: 400;
        }
        /* RED DEADLINE SECTION - NEW ADDITION */
        .deadline-red {
            background-color: #fff0f0;
            border-left: 4px solid #e53e3e;
            padding: 14px 18px;
            border-radius: 12px;
            margin: 24px 0 28px 0;
            text-align: center;
        }
        .deadline-red p {
            margin: 0;
            font-size: 15px;
            font-weight: 600;
            color: #b91c1c;
            letter-spacing: 0.2px;
        }
        .deadline-red .deadline-date {
            font-weight: 800;
            background: rgba(229, 62, 62, 0.1);
            display: inline-block;
            padding: 0 4px;
            border-radius: 6px;
        }
        .security-note {
            background: #F8FAFE;
            border-left: 3px solid #1A5D7D;
            padding: 16px 20px;
            border-radius: 16px;
            margin: 28px 0 24px 0;
        }
        .security-note p {
            margin-bottom: 0;
            font-size: 14px;
            color: #1F3A4F;
            font-weight: 500;
        }
        /* CTA button - NEW: centered, smaller, 10% rounded */
        .button-wrapper {
            margin: 32px 0 16px 0;
            text-align: center;
        }
        .btn-update {
            display: inline-block;
            background: #0B1426;
            color: #FFFFFF;
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
            padding: 10px 24px;
            border-radius: 10%;  /* 10% rounded as requested */
            text-align: center;
            transition: all 0.2s ease;
            border: none;
            box-shadow: 0 2px 6px rgba(11, 20, 38, 0.15);
            letter-spacing: 0.3px;
        }
        .btn-update:hover {
            background: #1A2C3E;
            transform: translateY(-1px);
            box-shadow: 0 6px 14px rgba(11, 20, 38, 0.2);
        }
        /* Feature grid (brand touches) */
        .feature-grid {
            display: flex;
            gap: 20px;
            margin: 32px 0 24px;
            flex-wrap: wrap;
        }
        .feature-item {
            flex: 1;
            display: flex;
            align-items: center;
            gap: 12px;
            background: #F9FBFE;
            padding: 12px 16px;
            border-radius: 20px;
            min-width: 130px;
        }
        .feature-icon {
            font-size: 24px;
        }
        .feature-text {
            font-size: 13px;
            font-weight: 500;
            color: #1F3A4F;
        }
        /* Divider */
        .soft-divider {
            height: 1px;
            background: linear-gradient(90deg, #E2E8F0 0%, #CBD5E1 50%, #E2E8F0 100%);
            margin: 32px 0 24px;
        }
        /* Footer brand */
        .footer-brand {
            background: #FCFDFF;
            padding: 28px 32px 32px;
            text-align: center;
            border-top: 1px solid #EDF2F7;
        }
        .footer-links {
            display: flex;
            justify-content: center;
            gap: 28px;
            flex-wrap: wrap;
            margin-bottom: 20px;
        }
        .footer-links a {
            color: #4A6A85;
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
            transition: color 0.2s;
        }
        .footer-links a:hover {
            color: #0B1426;
        }
        .copyright {
            font-size: 11px;
            color: #7C8F9F;
            margin-top: 16px;
            line-height: 1.4;
        }
        .ledger-tagline {
            font-size: 10px;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            color: #9AAEBF;
            margin-bottom: 12px;
            font-weight: 500;
        }
        /* Responsive */
        @media only screen and (max-width: 560px) {
            .content-area {
                padding: 28px 24px 36px 24px;
            }
            .brand-header {
                padding: 28px 24px 24px 24px;
            }
            h1 {
                font-size: 28px;
            }
            .btn-update {
                padding: 9px 22px;
                font-size: 13px;
                width: auto;
                display: inline-block;
            }
            .feature-grid {
                flex-direction: column;
                gap: 12px;
            }
            .feature-item {
                width: 100%;
            }
            .footer-links {
                gap: 18px;
            }
            .deadline-red p {
                font-size: 14px;
            }
